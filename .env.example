# --- Signed links (required) --------------------------------------------------
# Shared with whatever mints playback links (e.g. your dashboard).
# At least 32 chars, [A-Za-z0-9_-]. Generate with: openssl rand -hex 32
STREAM_SECRET=

# --- UniFi Protect ------------------------------------------------------------
# Only needed when UNIFI_LOCAL_* (below) is not set.
# Site Manager API key (unifi.ui.com -> API). Admin-scoped: keep it secret.
UNIFI_API_KEY=
# From GET https://api.ui.com/v1/hosts. KEEP the ":<digits>" suffix.
UNIFI_HOST_ID=

# Cameras to relay: <Protect camera id>:<stream name>, comma separated.
# Find ids with GET <connector>/proxy/protect/integration/v1/cameras.
# Stream names appear in URLs: lowercase letters, digits, - and _ only.
RELAY_CAMERAS=

# high | medium | low. medium is plenty for a phone and much lighter.
RTSPS_QUALITY=medium

# If a camera's RTSPS output is off, turn it on in Protect at start-up.
# Set false to only use streams you enabled yourself.
UNIFI_ENABLE_RTSPS=true

# Optional: override the console address in Protect's RTSPS URLs if this box
# reaches the console by a different IP/hostname.
RTSPS_HOST=

# Camera audio. OFF unless set to true: the audio track is never pulled from
# the camera, so no viewer can get it. Does not apply to RELAY_STREAMS.
RELAY_AUDIO=false

# Optional: extra non-Protect go2rtc sources, name=source;name=source
RELAY_STREAMS=

# --- Local Protect API: live state + API proxy (optional) ----------------------
# With these set the relay talks to the console over the LAN instead of
# api.ui.com, and serves /api/state (live device state for browsers) and
# /api/protect (a narrow API proxy for the dashboard server). Neither counts
# against the cloud connector's rate limit. Camera RTSPS lookup at start-up
# uses the local API too.
#
# Console address as seen from this box (IP or IP:port).
UNIFI_LOCAL_HOST=
# Protect -> Settings -> Control Plane -> Integrations -> API key. NOT the
# Site Manager key above.
UNIFI_LOCAL_API_KEY=
# Optional: pin the console's self-signed certificate (SHA-256, hex). Without
# it the certificate is not verified. Get it with:
#   openssl s_client -connect <console>:443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
UNIFI_LOCAL_CERT_SHA256=
# The ONLY devices /api/state shows and /api/protect touches:
# kind:id,... with kind relay | light | sensor | camera. Cameras in
# RELAY_CAMERAS are added for snapshots automatically.
RELAY_DEVICES=
# Dashboard origins allowed to open /api/state, comma separated, exact match.
# e.g. https://www.coop.onl,https://internet-of-chicken.vercel.app
STATE_ORIGINS=

# --- Cloudflare Tunnel (optional) ----------------------------------------------
# Set to run the bundled cloudflared. Zero Trust -> Networks -> Tunnels ->
# Create (cloudflared) -> copy the token. Public hostname service: http://localhost:8080
# Leave empty to expose :8080 through your own tunnel or proxy instead.
TUNNEL_TOKEN=
