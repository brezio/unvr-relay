# --- Signed links (required) --------------------------------------------------
# Shared with whatever mints playback links (e.g. your dashboard).
# At least 32 chars, [A-Za-z0-9_-]. Generate with: openssl rand -hex 32
STREAM_SECRET=

# --- UniFi Protect ------------------------------------------------------------
# Site Manager API key (unifi.ui.com -> API). Admin-scoped: keep it secret.
UNIFI_API_KEY=
# From GET https://api.ui.com/v1/hosts. KEEP the ":<digits>" suffix.
UNIFI_HOST_ID=

# Cameras to relay: <Protect camera id>:<stream name>, comma separated.
# Find ids with GET <connector>/proxy/protect/integration/v1/cameras.
# Stream names appear in URLs: lowercase letters, digits, - and _ only.
RELAY_CAMERAS=

# high | medium | low. medium is plenty for a phone and much lighter.
RTSPS_QUALITY=medium

# If a camera's RTSPS output is off, turn it on in Protect at start-up.
# Set false to only use streams you enabled yourself.
UNIFI_ENABLE_RTSPS=true

# Optional: override the console address in Protect's RTSPS URLs if this box
# reaches the console by a different IP/hostname.
RTSPS_HOST=

# Optional: extra non-Protect go2rtc sources, name=source;name=source
RELAY_STREAMS=

# --- Cloudflare Tunnel (optional) ----------------------------------------------
# Set to run the bundled cloudflared. Zero Trust -> Networks -> Tunnels ->
# Create (cloudflared) -> copy the token. Public hostname service: http://localhost:8080
# Leave empty to expose :8080 through your own tunnel or proxy instead.
TUNNEL_TOKEN=
