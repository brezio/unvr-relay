# Generated by unvr-relay -- rewritten on every start, do not edit.
#
# The only listener reachable from outside the container. go2rtc is on
# loopback behind it.
#
# Every stream request must carry a signature minted with STREAM_SECRET:
#
#   ?src=<stream>&exp=<unix seconds>&sig=<base64url(md5("<exp><stream> <secret>"))>
#
# The signature covers the stream name, so a link for "coop" cannot be edited
# into "run" -- or into an arbitrary go2rtc source like exec:..., the real
# danger of exposing go2rtc. `exp` only gates STARTING playback; an open
# stream keeps going after it passes.

worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/nginx-client;
    proxy_temp_path       /tmp/nginx-proxy;
    fastcgi_temp_path     /tmp/nginx-fastcgi;
    uwsgi_temp_path       /tmp/nginx-uwsgi;
    scgi_temp_path        /tmp/nginx-scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8080;

        # Nothing here may be cached by a CDN in front (Cloudflare caches 301s
        # and .mp4/.jpeg/.ts by default). Observed 2026-10-07: go2rtc answers a
        # Safari user-agent's stream.mp4 with a 301 to HLS; Cloudflare cached it
        # per signed URL, so a Chrome viewer holding the SAME link (two page
        # loads in the same second sign identically) was sent to HLS and its
        # player died. `always` covers redirects and errors too.
        # go2rtc sets its own "Cache-Control: no-cache" on some responses, which
        # a CDN may still store (and revalidate). Replace it, never stack it.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;

        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }

        location ~ ^/api/(ws|stream\.mp4|stream\.m3u8|frame\.jpeg)$ {
            # Stream names only. Anything else is a go2rtc source URL, refused
            # even if someone obtained a signature for it.
            if ($arg_src !~ "^[a-z0-9_-]+$") { return 400; }

            secure_link $arg_sig,$arg_exp;
            secure_link_md5 "$arg_exp$arg_src @@STREAM_SECRET@@";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }

            proxy_pass http://127.0.0.1:1984;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_buffering off;
            proxy_read_timeout 1h;
        }

        # HLS follow-up requests: go2rtc issues a random per-session id in the
        # signed playlist, and segment URLs carry only that id.
        location ~ ^/api/hls/(playlist\.m3u8|segment\.ts|segment\.m4s|init\.mp4)$ {
            if ($arg_id !~ "^[A-Za-z0-9]+$") { return 400; }
            proxy_pass http://127.0.0.1:1984;
            proxy_buffering off;
        }

        # Live device state for browsers (read-only WebSocket) and the narrow
        # Protect API proxy for the dashboard server. Both are served by
        # unvr-state on loopback, which checks its own HMAC tokens, the
        # Origin and the allowlists; nginx only routes. 502 when unvr-state is
        # not running (UNIFI_LOCAL_* unset).
        location = /api/state {
            proxy_pass http://127.0.0.1:8090/state$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Origin $http_origin;
            proxy_buffering off;
            proxy_read_timeout 1h;
        }

        location /api/protect/ {
            proxy_pass http://127.0.0.1:8090/protect/;
            proxy_http_version 1.1;
            client_max_body_size 8k;
            proxy_buffering off;
            proxy_read_timeout 20s;
        }

        location / {
            return 404;
        }
    }
}
