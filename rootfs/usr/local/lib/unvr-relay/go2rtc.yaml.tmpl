# Generated by unvr-relay at @@STAMP@@ -- rewritten on every start, do not edit.
#
# Locked down on purpose: go2rtc can otherwise create streams from arbitrary
# sources, including exec. Only nginx (same container) can reach the API, and
# nginx only forwards signed playback requests. This is the second layer.

api:
  listen: "127.0.0.1:1984"
  origin: "*"
  allow_paths: [/api/ws, /api/stream.mp4, /api/stream.m3u8, /api/hls/playlist.m3u8, /api/hls/segment.ts, /api/hls/segment.m4s, /api/hls/init.mp4, /api/frame.jpeg]

# Loopback, NOT disabled: listen: "" turns off the whole RTSP module, which
# go2rtc also needs internally (ffmpeg sources, the rtsp/rtspx client).
# Verified on 1.9.14: "streams: exec: rtsp module disabled".
rtsp:
  listen: "127.0.0.1:8554"

# WebRTC media is UDP and does not cross a Cloudflare Tunnel.
webrtc:
  listen: ""

log:
  level: info

streams:
@@STREAMS@@
